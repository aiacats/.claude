# ═══ Secrets (API keys, tokens) ═══
.credentials.json
.notion-config
notion-config
mcp-needs-auth-cache.json

# ═══ Machine-specific settings ═══
# settings.json はGit共有対象（permissions 等、全PC共通の設定）。
# MCPサーバー登録は各PCで `claude mcp add` を実行する（settings.json には書かない）。
settings.local.json

